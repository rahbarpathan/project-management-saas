# ==============================================================================
# SprintFlow SaaS - Environment Variables Template
# Copy this file to .env or individual workspace .env files
# ==============================================================================

# ------------------------------------------------------------------------------
# API Configuration (apps/api/.env)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL Connection Strings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sprintflow_dev?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sprintflow_test?schema=public

# Frontend Origin for CORS & Socket Handshakes
CLIENT_URL=http://localhost:3000

# JWT Secrets (generate with: openssl rand -base64 32)
# Must be at least 32 characters in length
JWT_ACCESS_SECRET=sprintflow_access_secret_development_min32chars
JWT_REFRESH_SECRET=sprintflow_refresh_secret_development_min32chars

# Optional Redis Adapter for horizontal Socket.IO scaling
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Web Frontend Configuration (apps/web/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# Production Docker Compose Configuration (.env.production)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_in_prod
POSTGRES_DB=sprintflow_prod
WEB_PORT=3000
