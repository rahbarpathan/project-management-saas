{
  "name": "sprintflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @sprintflow/api dev",
    "dev:web": "pnpm --filter @sprintflow/web dev",
    "dev": "pnpm --filter \"@sprintflow/*\" --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @sprintflow/api test",
    "db:generate": "pnpm --filter @sprintflow/api db:generate",
    "db:migrate": "pnpm --filter @sprintflow/api db:migrate",
    "db:seed": "pnpm --filter @sprintflow/api db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.24.0"
  }
}
